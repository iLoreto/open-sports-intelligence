{
  "name": "open-sports-intelligence-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "builds": "npm run build",
    "typecheck:worker": "tsc --ignoreConfig --noEmit --allowImportingTsExtensions --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM --skipLibCheck worker/index.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:cache": "node --experimental-strip-types --test worker/scan-cache.test.ts"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "~6.0.0",
    "wrangler": "^4.68.0"
  }
}
